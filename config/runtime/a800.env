#!/usr/bin/env bash
# Runtime environment for the A800 machine.

ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
PYTHON_BIN="${PYTHON_BIN:-${CONDA_PREFIX:+$CONDA_PREFIX/bin/python}}"
SFS_ROOT="${SFS_ROOT:-/home/ma-user/work/bucket-pangu-green/chenyanbo/hf_cache}"
HF_HOME="${HF_HOME:-$SFS_ROOT}"
HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
RUNS_ROOT="${RUNS_ROOT:-/home/ma-user/work/bucket-pangu-green/chenyanbo/decodeatt/runs}"
MODEL_ROOT="${MODEL_ROOT:-$HF_HOME/models}"

export ROOT_DIR PYTHON_BIN SFS_ROOT HF_HOME HF_ENDPOINT HF_DATASETS_CACHE RUNS_ROOT MODEL_ROOT

require_python() {
  if [[ -z "$PYTHON_BIN" ]]; then
    echo "Activate the conda environment or set PYTHON_BIN to its Python executable" >&2
    exit 1
  fi
  if [[ ! -x "$PYTHON_BIN" ]]; then
    echo "Missing executable python: $PYTHON_BIN" >&2
    exit 1
  fi
}

export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
